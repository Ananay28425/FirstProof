# Copy to .env; never commit it. Generate tokens with Python secrets.token_urlsafe(32).
MODE=local
OPERATOR_TOKEN=
PUBLIC_ORIGIN=http://127.0.0.1:8000
SECURE_COOKIES=false
# Native local development defaults to SQLite. Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./firstproof.db
POSTGRES_PASSWORD=
FAULTLAB_URL=http://127.0.0.1:8001
FAULTLAB_TOKEN=
# Set MODE=live only after Flagsmith prerequisites and database migration.
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
FLAGSMITH_DASHBOARD_URL=https://app.flagsmith.com
FLAGSMITH_EVENTS_URL=
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_ADMIN_KEY=
FLAGSMITH_PROJECT_ID=0
FLAGSMITH_FEATURE_ID=0
FLAGSMITH_CANDIDATE_ID=0
FLAGSMITH_FLAG=firstproof_retry_policy
# Optional separate release environment for live research; the app never writes it.
FLAGSMITH_RELEASE_ENVIRONMENT_KEY=
FLAGSMITH_RELEASE_FLAG=firstproof_retry_policy
SERPAPI_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
MAX_JOBS=8
WORKLOAD_CONCURRENCY=12
MAX_WORKLOADS=5000
SESSION_SEARCH_LIMIT=100
